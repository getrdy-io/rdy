{
  "ids": {
    "host.cpu": "HostCpuParams",
    "host.memory": "HostMemoryParams",
    "host.disk": "HostDiskParams",
    "host.ports": "HostPortsParams",
    "host.lsm": "HostLsmParams",
    "host.security_agents": "HostSecurityAgentsParams",
    "host.os": "HostOsParams",
    "net.egress": "NetEgressParams",
    "net.proxy": "NetProxyParams",
    "net.tls_intercept": "NetTlsInterceptParams",
    "net.dns": "NetDnsParams",
    "k8s.access": "K8sAccessParams",
    "k8s.storageclass": "K8sStorageClassParams",
    "k8s.rbac": "K8sRbacParams",
    "k8s.admission": "K8sAdmissionParams",
    "k8s.nodes": "K8sNodesParams",
    "k8s.version": "K8sVersionParams"
  },
  "$defs": {
    "Regex": {
      "description": "A regular expression in Rust regex syntax (linear time, no backreferences).",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "1 to 65535."
    },
    "Cidr": {
      "description": "An IPv4 or IPv6 address range such as 10.0.0.0/8 or fd00::/8.",
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(3[0-2]|[12]?[0-9])|(([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,7}:|([0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2}|([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3}|([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4}|([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(:[0-9A-Fa-f]{1,4}){1,6}|:((:[0-9A-Fa-f]{1,4}){1,7}|:))/(12[0-8]|1[01][0-9]|[1-9]?[0-9]))$"
    },
    "AbsPath": {
      "description": "An absolute path: /... on Unix, C:\\... on Windows. No control characters.",
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(/|[A-Za-z]:\\\\)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "K8sName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
    },
    "K8sLabelKey": {
      "description": "A Kubernetes label or taint key: a name, or prefix/name with a lowercase DNS-style prefix.",
      "type": "string",
      "maxLength": 317,
      "pattern": "^(?![^/]{254,}/)([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
    },
    "K8sLabelValue": {
      "description": "A Kubernetes label or taint value: empty, or up to 63 letters, digits, -, _ and ., starting and ending with a letter or digit.",
      "type": "string",
      "maxLength": 63,
      "pattern": "^([A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?)?$"
    },
    "DnsName": {
      "description": "A host name by the grammar of Target: dot-separated labels of 1 to 63 letters, digits and hyphens that do not start or end with a hyphen. The last label is not a number (2852039166, 0xa9).",
      "type": "string",
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
      "not": {
        "pattern": "(^|\\.)([0-9]+|0[xX][0-9a-fA-F]*)$"
      }
    },
    "StringList": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "HostCpuParams": {
      "properties": {
        "min": {
          "description": "Minimum CPU cores rdy can use (container limits count).",
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "recommended": {
          "description": "Below this many cores: warn.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "arch": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x86_64",
              "aarch64",
              "amd64",
              "arm64"
            ]
          },
          "description": "CPU architectures the product runs on. A machine with another architecture blocks the check."
        },
        "flags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "description": "CPU feature flags the product needs, such as `avx2`. A missing flag blocks the check."
        }
      },
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "arch"
          ]
        },
        {
          "required": [
            "flags"
          ]
        }
      ],
      "examples": [
        {
          "id": "host.cpu",
          "min": 4,
          "recommended": 8
        }
      ]
    },
    "HostMemoryParams": {
      "properties": {
        "min": {
          "description": "Minimum total RAM.",
          "$ref": "#/$defs/Quantity"
        },
        "min_available": {
          "description": "Below this much free RAM: warn. Default half of min.",
          "$ref": "#/$defs/Quantity"
        },
        "swap": {
          "description": "forbid: swap must be off.",
          "enum": [
            "forbid",
            "any"
          ],
          "default": "any"
        },
        "tolerance_percent": {
          "description": "How far below min still passes, in percent, because a 32 GiB machine shows a little less. Default 5, at least 256 MiB. 0 turns it off.",
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "tolerance_result": {
          "description": "What a value inside the tolerance counts as.",
          "enum": [
            "pass",
            "warn"
          ],
          "default": "pass"
        }
      },
      "required": [
        "min"
      ],
      "examples": [
        {
          "id": "host.memory",
          "min": "16Gi"
        }
      ]
    },
    "HostDiskParams": {
      "required": [
        "path",
        "min"
      ],
      "properties": {
        "path": {
          "description": "Install path. If it does not exist yet, the nearest existing parent is measured.",
          "$ref": "#/$defs/AbsPath"
        },
        "min": {
          "description": "Minimum free space.",
          "$ref": "#/$defs/Quantity"
        },
        "recommended": {
          "description": "Below this much free space: warn. Default min plus 20%.",
          "$ref": "#/$defs/Quantity"
        },
        "min_inodes": {
          "type": "integer",
          "minimum": 0,
          "description": "Fewest free inodes on the file system. A file system that reports no inode count is skipped."
        },
        "forbid_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "noexec",
              "nosuid",
              "nodev",
              "ro"
            ]
          },
          "description": "Mount options that block the check when the path has them, such as `noexec`."
        },
        "forbid_fstypes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.]{1,32}$"
          },
          "description": "File system types that block the check when the path uses them, such as `nfs`."
        }
      },
      "examples": [
        {
          "id": "host.disk",
          "path": "/var/lib/acme",
          "min": "50Gi",
          "recommended": "60Gi"
        }
      ]
    },
    "HostPortsParams": {
      "properties": {
        "free": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Port"
              },
              {
                "type": "object",
                "required": [
                  "port"
                ],
                "additionalProperties": false,
                "properties": {
                  "port": {
                    "$ref": "#/$defs/Port"
                  },
                  "bind": {
                    "enum": [
                      "public",
                      "loopback"
                    ],
                    "default": "public",
                    "description": "`public` for a port the product serves on all addresses. `loopback` for a port it serves on the loopback address only."
                  }
                }
              }
            ]
          },
          "description": "TCP ports that must be free. A port that another process holds blocks the check."
        },
        "udp_free": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Port"
          },
          "description": "UDP ports that must be free. A port that another process holds blocks the check."
        },
        "allow_owner": {
          "description": "Process names that may already hold a port, such as an earlier install of the product.",
          "$ref": "#/$defs/StringList"
        }
      },
      "anyOf": [
        {
          "required": [
            "free"
          ]
        },
        {
          "required": [
            "udp_free"
          ]
        }
      ],
      "examples": [
        {
          "id": "host.ports",
          "free": [
            80,
            443,
            6443,
            10250
          ]
        }
      ]
    },
    "HostLsmParams": {
      "properties": {
        "selinux": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "enforcing",
                  "permissive",
                  "disabled"
                ]
              },
              "description": "SELinux modes that pass. A mode outside this list blocks the check."
            },
            "denials_max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "description": "Most SELinux denials allowed in the window. More than this warns."
            },
            "denials_window": {
              "$ref": "#/$defs/Duration"
            },
            "watch": {
              "$ref": "#/$defs/StringList",
              "description": "Contexts whose denials block the check instead of warning, such as `container_t`."
            }
          },
          "description": "SELinux checks. Leave it out to skip them."
        },
        "apparmor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "enabled",
                  "disabled"
                ]
              },
              "description": "AppArmor modes that pass. A mode outside this list blocks the check."
            },
            "require_profiles": {
              "$ref": "#/$defs/StringList",
              "description": "AppArmor profiles that must be loaded."
            }
          },
          "description": "AppArmor checks. Leave it out to skip them."
        }
      },
      "examples": [
        {
          "id": "host.lsm",
          "selinux": {
            "allow": [
              "enforcing"
            ],
            "denials_max": 0
          }
        }
      ]
    },
    "HostSecurityAgentsParams": {
      "properties": {
        "forbid": {
          "description": "Agent ids that block. Run rdy spec lint to see the known ids.",
          "$ref": "#/$defs/StringList"
        },
        "allow": {
          "description": "Agent ids that are fine. Run rdy spec lint to see the known ids.",
          "$ref": "#/$defs/StringList"
        }
      },
      "examples": [
        {
          "id": "host.security_agents",
          "forbid": [
            "example-agent"
          ]
        }
      ]
    },
    "HostOsParams": {
      "properties": {
        "supported": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "Distribution id from /etc/os-release, such as rhel or ubuntu.",
                "type": "string",
                "pattern": "^[a-z0-9._-]{1,32}$"
              },
              "versions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 32
                },
                "description": "Versions that pass, such as `8` for a major version or `22.04` for one exact version."
              }
            }
          },
          "description": "Distributions and versions the product supports. Any other distribution or version blocks the check."
        },
        "arch": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "x86_64",
              "aarch64",
              "amd64",
              "arm64"
            ]
          },
          "description": "CPU architectures the product runs on. A machine with another architecture blocks the check."
        },
        "fips": {
          "enum": [
            "forbid",
            "require",
            "any"
          ],
          "default": "any",
          "description": "`forbid` needs FIPS mode off, `require` needs it on, and `any` accepts either."
        },
        "windows_min_build": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Lowest Windows build number that passes."
        }
      },
      "examples": [
        {
          "id": "host.os",
          "supported": [
            {
              "id": "ubuntu",
              "versions": [
                "22.04"
              ]
            }
          ],
          "fips": "any"
        }
      ]
    },
    "NetEgressParams": {
      "required": [
        "endpoints"
      ],
      "properties": {
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Target"
              },
              {
                "type": "object",
                "required": [
                  "target"
                ],
                "additionalProperties": false,
                "properties": {
                  "target": {
                    "$ref": "#/$defs/Target"
                  },
                  "optional": {
                    "description": "Unreachable gives warn instead of block.",
                    "type": "boolean",
                    "default": false
                  },
                  "expect_status": {
                    "description": "URL targets only.",
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    }
                  },
                  "method": {
                    "description": "URL targets only.",
                    "enum": [
                      "HEAD",
                      "GET"
                    ],
                    "default": "HEAD"
                  },
                  "via_proxy": {
                    "enum": [
                      "auto",
                      "direct",
                      "proxy_only"
                    ],
                    "description": "How this endpoint uses the proxy. The values are the same as for the check."
                  },
                  "tls": {
                    "description": "false probes plain TCP only. Default true for port 443 and https URLs.",
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "description": "At most 64 endpoints in one check. A spec names at most 64 distinct hosts and 256 distinct host and port pairs across all its checks."
        },
        "via_proxy": {
          "description": "auto: try what the product would do and say if the other path works. direct: no proxy. proxy_only: only through the proxy.",
          "enum": [
            "auto",
            "direct",
            "proxy_only"
          ],
          "default": "auto"
        },
        "trust": {
          "enum": [
            "system",
            "bundled"
          ],
          "default": "system",
          "description": "Which certificate authorities verify each endpoint. `system` uses the operating system store. `bundled` uses the roots that ship inside rdy."
        },
        "max_latency": {
          "description": "Connect slower than this: warn. Default 2s.",
          "$ref": "#/$defs/Duration"
        }
      },
      "examples": [
        {
          "id": "net.egress",
          "endpoints": [
            "https://example.com/"
          ]
        }
      ]
    },
    "NetProxyParams": {
      "properties": {
        "required_no_proxy": {
          "description": "Entries NO_PROXY must cover, such as .svc or 10.0.0.0/8.",
          "$ref": "#/$defs/StringList"
        },
        "daemons_need_proxy": {
          "type": "boolean",
          "default": false,
          "description": "When true, a container runtime or the kubelet without the proxy settings blocks the check. When false, it warns."
        }
      },
      "examples": [
        {
          "id": "net.proxy",
          "required_no_proxy": [
            ".svc",
            ".cluster.local"
          ]
        }
      ]
    },
    "NetTlsInterceptParams": {
      "properties": {
        "hosts": {
          "description": "Default: the hosts of every net.egress endpoint in this spec.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 259,
            "pattern": "^[A-Za-z0-9.-]+(:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"
          }
        },
        "expected_issuer": {
          "$ref": "#/$defs/Regex"
        },
        "pin_sha256": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "description": "SHA-256 pins of the certificates the product expects, 64 lowercase hex characters each. A chain that matches none of them blocks the check."
        },
        "forbid_interception": {
          "type": "boolean",
          "default": false,
          "description": "When true, an inspecting proxy blocks the check. When false, it only warns."
        }
      },
      "examples": [
        {
          "id": "net.tls_intercept",
          "hosts": [
            "example.com"
          ],
          "forbid_interception": true
        }
      ]
    },
    "NetDnsParams": {
      "required": [
        "names"
      ],
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/DnsName"
              },
              {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "$ref": "#/$defs/DnsName"
                  },
                  "expect_in": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "$ref": "#/$defs/Cidr"
                    },
                    "description": "Ranges that the answers must fall in, such as `10.0.0.0/8`."
                  },
                  "expect_public": {
                    "type": "boolean",
                    "description": "Whether the answers must be public addresses. Leave it out to skip this test."
                  }
                }
              }
            ]
          },
          "description": "Names to resolve. Each entry is a name, or an object with the name and what its answers must look like."
        },
        "max_latency": {
          "description": "Lookup slower than this: warn. Default 500ms.",
          "$ref": "#/$defs/Duration"
        }
      },
      "examples": [
        {
          "id": "net.dns",
          "names": [
            "example.com"
          ]
        }
      ]
    },
    "K8sAccessParams": {
      "properties": {
        "context_pattern": {
          "description": "The current kube context must match, a guard against the wrong cluster.",
          "$ref": "#/$defs/Regex"
        },
        "max_latency": {
          "$ref": "#/$defs/Duration"
        },
        "server_pattern": {
          "description": "The API server URL must match.",
          "$ref": "#/$defs/Regex"
        }
      },
      "examples": [
        {
          "id": "k8s.access",
          "context_pattern": "^acme-"
        }
      ]
    },
    "K8sStorageClassParams": {
      "properties": {
        "class": {
          "description": "A storage class that must exist. Default: the cluster's default class.",
          "$ref": "#/$defs/K8sName"
        },
        "access_modes": {
          "$ref": "#/$defs/AccessModes",
          "description": "Access modes the volumes need. The class must support each one."
        },
        "binding": {
          "enum": [
            "WaitForFirstConsumer",
            "Immediate",
            "any"
          ],
          "default": "any",
          "description": "When the volume is bound. `WaitForFirstConsumer` waits for a pod. `Immediate` binds at once. `any` accepts either."
        },
        "expansion": {
          "type": "boolean",
          "description": "When true, the class must allow volume expansion."
        },
        "reclaim_policy": {
          "description": "Mismatch gives warn.",
          "enum": [
            "Retain",
            "Delete"
          ]
        }
      },
      "examples": [
        {
          "id": "k8s.storageclass",
          "class": "standard",
          "access_modes": [
            "ReadWriteOnce"
          ]
        }
      ]
    },
    "AccessModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ReadWriteOnce",
          "ReadOnlyMany",
          "ReadWriteMany",
          "ReadWriteOncePod"
        ]
      }
    },
    "K8sRbacParams": {
      "required": [
        "can"
      ],
      "properties": {
        "can": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "description": "verb resource[.group][/subresource], as in kubectl auth can-i.",
                "type": "string",
                "pattern": "^[a-z*]{1,63} [a-z0-9*-]{1,253}(\\.[a-z0-9.-]{1,253})?(/[a-z]{1,63})?$"
              },
              {
                "type": "object",
                "required": [
                  "verb",
                  "resource"
                ],
                "additionalProperties": false,
                "properties": {
                  "verb": {
                    "type": "string",
                    "pattern": "^[a-z*]+$",
                    "maxLength": 63,
                    "description": "The verb, such as `create`. Use `*` for any verb."
                  },
                  "group": {
                    "type": "string",
                    "pattern": "^[a-z0-9.-]*$",
                    "maxLength": 253,
                    "description": "The API group, such as `apps`. Leave it empty for the core group."
                  },
                  "resource": {
                    "type": "string",
                    "pattern": "^[a-z0-9*-]+$",
                    "maxLength": 253,
                    "description": "The resource, such as `pods`. Use `*` for any resource."
                  },
                  "subresource": {
                    "type": "string",
                    "pattern": "^[a-z]+$",
                    "maxLength": 63,
                    "description": "The subresource, such as `status`. Leave it out for the resource itself."
                  },
                  "namespace": {
                    "$ref": "#/$defs/K8sName",
                    "description": "The namespace the permission is needed in. Leave it out for cluster scope."
                  },
                  "name": {
                    "$ref": "#/$defs/K8sName",
                    "description": "The name of one object. Leave it out for any name."
                  }
                }
              }
            ]
          },
          "description": "Permissions the install identity needs. Each entry is a verb and a resource as kubectl writes them, or an object with the parts spelled out."
        },
        "namespace": {
          "description": "Namespace for string items. Default: cluster scope.",
          "$ref": "#/$defs/K8sName"
        }
      },
      "examples": [
        {
          "id": "k8s.rbac",
          "can": [
            "create namespaces"
          ]
        }
      ]
    },
    "K8sAdmissionParams": {
      "properties": {
        "pod_security": {
          "description": "The Pod Security level the product's pods need.",
          "enum": [
            "privileged",
            "baseline",
            "restricted"
          ]
        },
        "namespace": {
          "$ref": "#/$defs/K8sName",
          "description": "The namespace the product's pods run in. The check reads the policies that apply there."
        },
        "scc": {
          "description": "The OpenShift security context constraint the product documents.",
          "$ref": "#/$defs/K8sName"
        },
        "uses": {
          "description": "Pod features the product needs; the check derives the minimum Pod Security level.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "hostPath",
              "hostNetwork",
              "hostPID",
              "privileged",
              "runAsRoot"
            ]
          }
        }
      },
      "description": "Dry-run checks are not supported yet.",
      "examples": [
        {
          "id": "k8s.admission",
          "pod_security": "baseline",
          "namespace": "acme"
        }
      ]
    },
    "K8sNodesParams": {
      "properties": {
        "min_ready": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Fewest ready nodes that match the selector and the architecture."
        },
        "min_zones": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Fewest availability zones that the matching nodes span. Zones come from node labels."
        },
        "per_node": {
          "$ref": "#/$defs/K8sResources",
          "description": "Size of one matching node the product needs. Use allocatable values, not the instance size."
        },
        "free": {
          "$ref": "#/$defs/K8sResources",
          "description": "Capacity that must be unclaimed across the matching nodes."
        },
        "arch": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "amd64",
              "arm64",
              "x86_64",
              "aarch64"
            ]
          },
          "description": "CPU architectures of the nodes that count. Nodes with other architectures do not count."
        },
        "selector": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "$ref": "#/$defs/K8sLabelKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/K8sLabelValue"
          },
          "description": "Node labels that a node must have to count. Up to 16 pairs."
        },
        "tolerations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "description": "Without a key the operator must be Exists. With Exists there is no value.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "$ref": "#/$defs/K8sLabelKey"
              },
              "operator": {
                "enum": [
                  "Equal",
                  "Exists"
                ],
                "description": "How the key matches. `Exists` matches any value. `Equal` needs a value."
              },
              "value": {
                "$ref": "#/$defs/K8sLabelValue"
              },
              "effect": {
                "enum": [
                  "NoSchedule",
                  "PreferNoSchedule",
                  "NoExecute"
                ],
                "description": "The taint effect to tolerate. Leave it out to match every effect."
              }
            },
            "if": {
              "required": [
                "operator"
              ],
              "properties": {
                "operator": {
                  "const": "Exists"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "maxLength": 0
                }
              }
            },
            "else": {
              "required": [
                "key"
              ]
            }
          },
          "description": "Taints the product tolerates. A node with a taint that is not listed does not count."
        }
      },
      "anyOf": [
        {
          "required": [
            "min_ready"
          ]
        },
        {
          "required": [
            "per_node"
          ]
        },
        {
          "required": [
            "free"
          ]
        }
      ],
      "examples": [
        {
          "id": "k8s.nodes",
          "min_ready": 3,
          "per_node": {
            "cpu": 7,
            "memory": "28Gi"
          }
        }
      ]
    },
    "K8sResources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "description": "Cores as a number from 0.001 to 1000000 with at most three decimals, or a string of whole cores (\"4\") or millicores (\"500m\"), up to 1000000 cores.",
          "oneOf": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 1000000
            },
            {
              "type": "string",
              "pattern": "^([1-9][0-9]{0,5}|1000000|([1-9][0-9]{0,8}|1000000000)m)$"
            }
          ]
        },
        "memory": {
          "$ref": "#/$defs/Quantity"
        },
        "pods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Pods that one node allows. This is the allocatable pod count, which is often low on small instances."
        },
        "ephemeral": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "minProperties": 1
    },
    "K8sVersionParams": {
      "properties": {
        "min": {
          "$ref": "#/$defs/Version"
        },
        "max": {
          "$ref": "#/$defs/Version"
        },
        "apis": {
          "description": "group/version Kind, for example networking.k8s.io/v1 Ingress.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 320,
            "pattern": "^([a-z0-9.-]+/)?v[0-9a-z]+ [A-Z][A-Za-z0-9]*$"
          }
        },
        "openshift_min": {
          "description": "Minimum OpenShift version, used when the cluster is OpenShift.",
          "$ref": "#/$defs/Version"
        },
        "over_max": {
          "description": "What a server newer than max counts as. Default warn.",
          "enum": [
            "warn",
            "block"
          ],
          "default": "warn"
        }
      },
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        },
        {
          "required": [
            "apis"
          ]
        },
        {
          "required": [
            "openshift_min"
          ]
        }
      ],
      "examples": [
        {
          "id": "k8s.version",
          "min": "1.28"
        }
      ]
    }
  }
}
