{
  "ids": {
    "host.cpu": "HostCpuParams",
    "host.memory": "HostMemoryParams",
    "host.disk": "HostDiskParams",
    "host.ports": "HostPortsParams",
    "host.lsm": "HostLsmParams",
    "host.security_agents": "HostSecurityAgentsParams",
    "host.os": "HostOsParams",
    "net.egress": "NetEgressParams",
    "net.proxy": "NetProxyParams",
    "net.tls_intercept": "NetTlsInterceptParams",
    "net.dns": "NetDnsParams",
    "k8s.access": "K8sAccessParams",
    "k8s.storageclass": "K8sStorageClassParams",
    "k8s.rbac": "K8sRbacParams",
    "k8s.admission": "K8sAdmissionParams",
    "k8s.nodes": "K8sNodesParams",
    "k8s.version": "K8sVersionParams"
  },
  "$defs": {
    "Regex": {
      "description": "A regular expression in Rust regex syntax (linear time, no backreferences).",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "1 to 65535."
    },
    "Cidr": {
      "description": "An IPv4 or IPv6 address range such as 10.0.0.0/8 or fd00::/8.",
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(3[0-2]|[12]?[0-9])|(([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,7}:|([0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2}|([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3}|([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4}|([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(:[0-9A-Fa-f]{1,4}){1,6}|:((:[0-9A-Fa-f]{1,4}){1,7}|:))/(12[0-8]|1[01][0-9]|[1-9]?[0-9]))$"
    },
    "AbsPath": {
      "description": "An absolute path: /... on Unix, C:\\... on Windows. No control characters.",
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(/|[A-Za-z]:\\\\)[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "K8sName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
    },
    "K8sLabelKey": {
      "description": "A Kubernetes label or taint key: a name, or prefix/name with a lowercase DNS-style prefix.",
      "type": "string",
      "maxLength": 317,
      "pattern": "^(?![^/]{254,}/)([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
    },
    "K8sLabelValue": {
      "description": "A Kubernetes label or taint value: empty, or up to 63 letters, digits, -, _ and ., starting and ending with a letter or digit.",
      "type": "string",
      "maxLength": 63,
      "pattern": "^([A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?)?$"
    },
    "DnsName": {
      "description": "A host name by the grammar of Target: dot-separated labels of 1 to 63 letters, digits and hyphens that do not start or end with a hyphen. The last label is not a number (2852039166, 0xa9).",
      "type": "string",
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
      "not": {
        "pattern": "(^|\\.)([0-9]+|0[xX][0-9a-fA-F]*)$"
      }
    },
    "StringList": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "HostCpuParams": {
      "properties": {
        "min": {
          "description": "Fewer cores than this: the check fails. Container limits count.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "recommended": {
          "description": "Fewer cores than this: the check warns.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "arch": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x86_64",
              "aarch64",
              "amd64",
              "arm64"
            ]
          },
          "description": "The host must have one of these architectures. `amd64` is `x86_64` and `arm64` is `aarch64`."
        },
        "flags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "description": "CPU flags the host must have, such as `avx2` or `x86-64-v3`. At most 64."
        }
      },
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "arch"
          ]
        },
        {
          "required": [
            "flags"
          ]
        }
      ],
      "examples": [
        {
          "id": "host.cpu",
          "min": 4,
          "recommended": 8
        }
      ]
    },
    "HostMemoryParams": {
      "properties": {
        "min": {
          "description": "Less total RAM than this: the check fails, after the tolerance.",
          "$ref": "#/$defs/Quantity"
        },
        "min_available": {
          "description": "Less available RAM than this: the check warns. The default, half of `min`, is the check's.",
          "$ref": "#/$defs/Quantity"
        },
        "swap": {
          "description": "What to do when swap is on. The default is `any`.",
          "enum": [
            "forbid",
            "any"
          ],
          "default": "any"
        },
        "tolerance_percent": {
          "description": "How far below `min` the total may be and still pass, in percent. A 32 GiB machine shows a little less. The default is 5. The check applies it with a floor of 256 MiB. 0 turns it off.",
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "tolerance_result": {
          "description": "What a total inside the tolerance counts as. The default is `pass`.",
          "enum": [
            "pass",
            "warn"
          ],
          "default": "pass"
        }
      },
      "required": [
        "min"
      ],
      "examples": [
        {
          "id": "host.memory",
          "min": "16Gi"
        }
      ]
    },
    "HostDiskParams": {
      "required": [
        "path",
        "min"
      ],
      "properties": {
        "path": {
          "description": "The install path. When it does not exist yet, the nearest existing parent is measured.",
          "$ref": "#/$defs/AbsPath"
        },
        "min": {
          "description": "Less free space than this: the check fails.",
          "$ref": "#/$defs/Quantity"
        },
        "recommended": {
          "description": "Less free space than this: the check warns. The default, `min` plus 20%, is the check's.",
          "$ref": "#/$defs/Quantity"
        },
        "min_inodes": {
          "type": "integer",
          "minimum": 0,
          "description": "Fewer free inodes than this: the check fails."
        },
        "forbid_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "noexec",
              "nosuid",
              "nodev",
              "ro"
            ]
          },
          "description": "Mount options that make the check fail."
        },
        "forbid_fstypes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.]{1,32}$"
          },
          "description": "Filesystem types that make the check fail, such as `nfs`. At most 32."
        }
      },
      "examples": [
        {
          "id": "host.disk",
          "path": "/var/lib/acme",
          "min": "50Gi",
          "recommended": "60Gi"
        }
      ]
    },
    "HostPortsParams": {
      "properties": {
        "free": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Port"
              },
              {
                "type": "object",
                "required": [
                  "port"
                ],
                "additionalProperties": false,
                "properties": {
                  "port": {
                    "$ref": "#/$defs/Port"
                  },
                  "bind": {
                    "enum": [
                      "public",
                      "loopback"
                    ],
                    "default": "public",
                    "description": "How the product binds it. `public` is the default and means every address. `loopback` means loopback only."
                  }
                }
              }
            ]
          },
          "description": "TCP ports that must be free. At most 256."
        },
        "udp_free": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Port"
          },
          "description": "UDP ports that must be free. At most 256, none twice."
        },
        "allow_owner": {
          "description": "Process names that may already hold a port, such as an earlier install of the product.",
          "$ref": "#/$defs/StringList"
        }
      },
      "anyOf": [
        {
          "required": [
            "free"
          ]
        },
        {
          "required": [
            "udp_free"
          ]
        }
      ],
      "examples": [
        {
          "id": "host.ports",
          "free": [
            80,
            443,
            6443,
            10250
          ]
        }
      ]
    },
    "HostLsmParams": {
      "properties": {
        "selinux": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "enforcing",
                  "permissive",
                  "disabled"
                ]
              },
              "description": "The modes that are fine. Any other mode makes the check fail. Without it every mode is fine."
            },
            "denials_max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "description": "More recent denials than this: the check warns. It fails when the context is in `watch`."
            },
            "denials_window": {
              "$ref": "#/$defs/Duration",
              "description": "How far back denials count, such as `24h`."
            },
            "watch": {
              "$ref": "#/$defs/StringList",
              "description": "Security contexts or programs whose denials make the check fail."
            }
          },
          "description": "What to expect of SELinux."
        },
        "apparmor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "enabled",
                  "disabled"
                ]
              },
              "description": "The states that are fine. Any other state makes the check fail."
            },
            "require_profiles": {
              "$ref": "#/$defs/StringList",
              "description": "Profiles that must be loaded."
            }
          },
          "description": "What to expect of AppArmor."
        }
      },
      "examples": [
        {
          "id": "host.lsm",
          "selinux": {
            "allow": [
              "enforcing"
            ],
            "denials_max": 0
          }
        }
      ]
    },
    "HostSecurityAgentsParams": {
      "properties": {
        "forbid": {
          "description": "Agent ids that make the check fail when detected. `rdy spec lint` lists the known ids.",
          "$ref": "#/$defs/StringList"
        },
        "allow": {
          "description": "Agent ids that are fine when detected.",
          "$ref": "#/$defs/StringList"
        }
      },
      "examples": [
        {
          "id": "host.security_agents",
          "forbid": [
            "example-agent"
          ]
        }
      ]
    },
    "HostOsParams": {
      "properties": {
        "supported": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "The distribution id from `/etc/os-release`, such as `rhel`.",
                "type": "string",
                "pattern": "^[a-z0-9._-]{1,32}$"
              },
              "versions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 32
                },
                "description": "The versions that are supported. `\"8\"` matches a major version and `\"22.04\"` an exact one. Without it every version is."
              }
            }
          },
          "description": "The distributions the product supports. At most 64."
        },
        "arch": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "x86_64",
              "aarch64",
              "amd64",
              "arm64"
            ]
          },
          "description": "The host must have one of these architectures."
        },
        "fips": {
          "enum": [
            "forbid",
            "require",
            "any"
          ],
          "default": "any",
          "description": "What to expect of FIPS mode. The default is `any`."
        },
        "windows_min_build": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "The lowest Windows build number that is supported."
        }
      },
      "examples": [
        {
          "id": "host.os",
          "supported": [
            {
              "id": "ubuntu",
              "versions": [
                "22.04"
              ]
            }
          ],
          "fips": "any"
        }
      ]
    },
    "NetEgressParams": {
      "required": [
        "endpoints"
      ],
      "properties": {
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Target"
              },
              {
                "type": "object",
                "required": [
                  "target"
                ],
                "additionalProperties": false,
                "properties": {
                  "target": {
                    "$ref": "#/$defs/Target",
                    "description": "Where to connect."
                  },
                  "optional": {
                    "description": "Unreachable gives a warning and not a block. The default is false.",
                    "type": "boolean",
                    "default": false
                  },
                  "expect_status": {
                    "description": "The statuses that count as reachable, for a URL target. At most 16.",
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    }
                  },
                  "method": {
                    "description": "The request method, for a URL target. The default is `HEAD`.",
                    "enum": [
                      "HEAD",
                      "GET"
                    ],
                    "default": "HEAD"
                  },
                  "via_proxy": {
                    "enum": [
                      "auto",
                      "direct",
                      "proxy_only"
                    ],
                    "description": "Overrides the `via_proxy` of the entry for this endpoint."
                  },
                  "tls": {
                    "description": "`false` probes plain TCP only. Without it TLS is tried for port 443 and `https` URLs.",
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "description": "The endpoints, 1 to 64."
        },
        "via_proxy": {
          "description": "Which path to try. The default is `auto`. `auto` tries what the product would do, and says if the other path works. `direct` uses no proxy. `proxy_only` goes only through the proxy.",
          "enum": [
            "auto",
            "direct",
            "proxy_only"
          ],
          "default": "auto"
        },
        "trust": {
          "enum": [
            "system",
            "bundled"
          ],
          "default": "system",
          "description": "Which certificates to trust. The default is `system`. `system` is the operating system's store, with the bundled public roots as a fallback. `bundled` is the bundled public roots only."
        },
        "max_latency": {
          "description": "A connect slower than this: the check warns. The default, 2s, is the check's.",
          "$ref": "#/$defs/Duration"
        }
      },
      "examples": [
        {
          "id": "net.egress",
          "endpoints": [
            "https://registry.acme.test/"
          ]
        }
      ]
    },
    "NetProxyParams": {
      "properties": {
        "required_no_proxy": {
          "description": "Entries that `NO_PROXY` must cover, such as `.svc` or `10.0.0.0/8`.",
          "$ref": "#/$defs/StringList"
        },
        "daemons_need_proxy": {
          "type": "boolean",
          "default": false,
          "description": "The container runtime and kubelet must have the proxy too. The default is false."
        }
      },
      "examples": [
        {
          "id": "net.proxy",
          "required_no_proxy": [
            ".svc",
            ".cluster.local"
          ]
        }
      ]
    },
    "NetTlsInterceptParams": {
      "properties": {
        "hosts": {
          "description": "The hosts to test, 1 to 64. The default is every `net.egress` host in the spec.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 259,
            "pattern": "^[A-Za-z0-9.-]+(:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"
          }
        },
        "expected_issuer": {
          "$ref": "#/$defs/Regex",
          "description": "A pattern the issuer of the chain must match. A chain from another issuer blocks."
        },
        "pin_sha256": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "description": "SHA-256 digests of certificates, 1 to 16, each 64 lowercase hex digits."
        },
        "forbid_interception": {
          "type": "boolean",
          "default": false,
          "description": "A chain that only this machine trusts blocks instead of warning. The default is false."
        }
      },
      "examples": [
        {
          "id": "net.tls_intercept",
          "hosts": [
            "registry.acme.test"
          ],
          "forbid_interception": true
        }
      ]
    },
    "NetDnsParams": {
      "required": [
        "names"
      ],
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/DnsName"
              },
              {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "$ref": "#/$defs/DnsName",
                    "description": "The name to look up."
                  },
                  "expect_in": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "$ref": "#/$defs/Cidr"
                    },
                    "description": "Every answer must be inside one of these ranges, 1 to 16."
                  },
                  "expect_public": {
                    "type": "boolean",
                    "description": "The answers must be public addresses (`true`) or private ones (`false`)."
                  }
                }
              }
            ]
          },
          "description": "The names to look up, 1 to 64."
        },
        "max_latency": {
          "description": "A lookup slower than this: the check warns. The default, 500ms, is the check's.",
          "$ref": "#/$defs/Duration"
        }
      },
      "examples": [
        {
          "id": "net.dns",
          "names": [
            "registry.acme.test"
          ]
        }
      ]
    },
    "K8sAccessParams": {
      "properties": {
        "context_pattern": {
          "description": "The current kube context must match this pattern, a guard against the wrong cluster.",
          "$ref": "#/$defs/Regex"
        },
        "max_latency": {
          "$ref": "#/$defs/Duration",
          "description": "A reply slower than this: the check warns. The default, 2s, is the check's."
        },
        "server_pattern": {
          "description": "The API server URL must match this pattern.",
          "$ref": "#/$defs/Regex"
        }
      },
      "examples": [
        {
          "id": "k8s.access",
          "context_pattern": "^acme-"
        }
      ]
    },
    "K8sStorageClassParams": {
      "properties": {
        "class": {
          "description": "A class that must exist. The default is the cluster's default class.",
          "$ref": "#/$defs/K8sName"
        },
        "access_modes": {
          "$ref": "#/$defs/AccessModes",
          "description": "Access modes the class must serve, 1 to 4."
        },
        "binding": {
          "enum": [
            "WaitForFirstConsumer",
            "Immediate",
            "any"
          ],
          "default": "any",
          "description": "The binding mode the class must have. The default is `any`."
        },
        "expansion": {
          "type": "boolean",
          "description": "The class must allow expansion."
        },
        "reclaim_policy": {
          "description": "The reclaim policy the class should have. A mismatch warns.",
          "enum": [
            "Retain",
            "Delete"
          ]
        }
      },
      "examples": [
        {
          "id": "k8s.storageclass",
          "class": "standard",
          "access_modes": [
            "ReadWriteOnce"
          ]
        }
      ]
    },
    "AccessModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ReadWriteOnce",
          "ReadOnlyMany",
          "ReadWriteMany",
          "ReadWriteOncePod"
        ]
      }
    },
    "K8sRbacParams": {
      "required": [
        "can"
      ],
      "properties": {
        "can": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "description": "verb resource[.group][/subresource], as in kubectl auth can-i.",
                "type": "string",
                "pattern": "^[a-z*]{1,63} [a-z0-9*-]{1,253}(\\.[a-z0-9.-]{1,253})?(/[a-z]{1,63})?$"
              },
              {
                "type": "object",
                "required": [
                  "verb",
                  "resource"
                ],
                "additionalProperties": false,
                "properties": {
                  "verb": {
                    "type": "string",
                    "pattern": "^[a-z*]+$",
                    "maxLength": 63,
                    "description": "The verb. An RBAC verb such as `create`. `*` means all verbs."
                  },
                  "group": {
                    "type": "string",
                    "pattern": "^[a-z0-9.-]*$",
                    "maxLength": 253,
                    "description": "The API group. Empty, which is the default, is the core group."
                  },
                  "resource": {
                    "type": "string",
                    "pattern": "^[a-z0-9*-]+$",
                    "maxLength": 253,
                    "description": "The resource. An RBAC resource such as `namespaces`. `*` means all resources."
                  },
                  "subresource": {
                    "type": "string",
                    "pattern": "^[a-z]+$",
                    "maxLength": 63,
                    "description": "The subresource, such as `log`."
                  },
                  "namespace": {
                    "$ref": "#/$defs/K8sName",
                    "description": "The namespace of the object. For a string item this is the `namespace` of the entry."
                  },
                  "name": {
                    "$ref": "#/$defs/K8sName",
                    "description": "The name of the object. Leave it out to mean all names."
                  }
                }
              }
            ]
          },
          "description": "The permissions to test, 1 to 100. Each one is an entry in the audit log of the cluster."
        },
        "namespace": {
          "description": "The namespace for the string items. The default is cluster scope.",
          "$ref": "#/$defs/K8sName"
        }
      },
      "examples": [
        {
          "id": "k8s.rbac",
          "can": [
            "create namespaces"
          ]
        }
      ]
    },
    "K8sAdmissionParams": {
      "properties": {
        "pod_security": {
          "description": "The Pod Security level the product's pods need.",
          "enum": [
            "privileged",
            "baseline",
            "restricted"
          ]
        },
        "namespace": {
          "$ref": "#/$defs/K8sName",
          "description": "The namespace the product installs into."
        },
        "scc": {
          "description": "The OpenShift security context constraint the product documents.",
          "$ref": "#/$defs/K8sName"
        },
        "uses": {
          "description": "Pod features the product needs. The check derives the lowest level from them.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "hostPath",
              "hostNetwork",
              "hostPID",
              "privileged",
              "runAsRoot"
            ]
          }
        }
      },
      "description": "Dry-run checks are not supported yet.",
      "examples": [
        {
          "id": "k8s.admission",
          "pod_security": "baseline",
          "namespace": "acme"
        }
      ]
    },
    "K8sNodesParams": {
      "properties": {
        "min_ready": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Fewer ready nodes than this: the check fails."
        },
        "min_zones": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Fewer zones than this: the check fails. Without zone labels it is not evaluated."
        },
        "per_node": {
          "$ref": "#/$defs/K8sResources",
          "description": "Each counted node must have at least this much allocatable. These are allocatable amounts, not the size of the instance."
        },
        "free": {
          "$ref": "#/$defs/K8sResources",
          "description": "The counted nodes together must have at least this much left after the pods' requests."
        },
        "arch": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "amd64",
              "arm64",
              "x86_64",
              "aarch64"
            ]
          },
          "description": "The architectures the counted nodes may have, 1 to 4. `amd64` is `x86_64`."
        },
        "selector": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "$ref": "#/$defs/K8sLabelKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/K8sLabelValue"
          },
          "description": "Only nodes with these labels are counted."
        },
        "tolerations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "description": "Without a key the operator must be Exists. With Exists there is no value.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "$ref": "#/$defs/K8sLabelKey",
                "description": "The taint key. Without it the operator is `Exists` and every taint matches."
              },
              "operator": {
                "enum": [
                  "Equal",
                  "Exists"
                ],
                "description": "How the value is compared. Kubernetes treats a missing operator as `Equal`."
              },
              "value": {
                "$ref": "#/$defs/K8sLabelValue",
                "description": "The taint value. Not with `Exists`."
              },
              "effect": {
                "enum": [
                  "NoSchedule",
                  "PreferNoSchedule",
                  "NoExecute"
                ],
                "description": "The effect to tolerate. Without it every effect matches."
              }
            },
            "if": {
              "required": [
                "operator"
              ],
              "properties": {
                "operator": {
                  "const": "Exists"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "maxLength": 0
                }
              }
            },
            "else": {
              "required": [
                "key"
              ]
            }
          },
          "description": "Tolerations that make tainted nodes count, at most 16."
        }
      },
      "anyOf": [
        {
          "required": [
            "min_ready"
          ]
        },
        {
          "required": [
            "per_node"
          ]
        },
        {
          "required": [
            "free"
          ]
        }
      ],
      "examples": [
        {
          "id": "k8s.nodes",
          "min_ready": 3,
          "per_node": {
            "cpu": 7,
            "memory": "28Gi"
          }
        }
      ]
    },
    "K8sResources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "description": "Cores as a number from 0.001 to 1000000 with at most three decimals, or a string of whole cores (\"4\") or millicores (\"500m\"), up to 1000000 cores.",
          "oneOf": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 1000000
            },
            {
              "type": "string",
              "pattern": "^([1-9][0-9]{0,5}|1000000|([1-9][0-9]{0,8}|1000000000)m)$"
            }
          ]
        },
        "memory": {
          "$ref": "#/$defs/Quantity",
          "description": "Memory."
        },
        "pods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Pod slots."
        },
        "ephemeral": {
          "$ref": "#/$defs/Quantity",
          "description": "Ephemeral storage."
        }
      },
      "minProperties": 1
    },
    "K8sVersionParams": {
      "properties": {
        "min": {
          "$ref": "#/$defs/Version",
          "description": "An older server blocks."
        },
        "max": {
          "$ref": "#/$defs/Version",
          "description": "A newer server warns, or blocks with `over_max: block`."
        },
        "apis": {
          "description": "APIs the server must serve, 1 to 64. Each one is written `group/version Kind`, or `version Kind` for the core group.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 320,
            "pattern": "^([a-z0-9.-]+/)?v[0-9a-z]+ [A-Z][A-Za-z0-9]*$"
          }
        },
        "openshift_min": {
          "description": "The lowest OpenShift version, used when the cluster is OpenShift.",
          "$ref": "#/$defs/Version"
        },
        "over_max": {
          "description": "What a server newer than `max` counts as. The default is `warn`.",
          "enum": [
            "warn",
            "block"
          ],
          "default": "warn"
        }
      },
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        },
        {
          "required": [
            "apis"
          ]
        },
        {
          "required": [
            "openshift_min"
          ]
        }
      ],
      "examples": [
        {
          "id": "k8s.version",
          "min": "1.28"
        }
      ]
    }
  }
}
