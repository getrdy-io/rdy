{
  "properties": {
    "rule": {
      "description": "For a denied call, the rule that refused it. Absent otherwise.",
      "type": "string",
      "maxLength": 4096
    },
    "error": {
      "description": "Why the call failed, as a fixed phrase. Absent otherwise.",
      "type": "string",
      "maxLength": 4096
    },
    "program": {
      "type": "string",
      "description": "exec",
      "maxLength": 4096
    },
    "argv": {
      "description": "exec, after redaction",
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "exit": {
      "description": "exec",
      "type": [
        "integer",
        "null"
      ]
    },
    "stdout_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "exec"
    },
    "path": {
      "type": "string",
      "description": "read, read_dir, stat, native, kube. Paths under a home directory start with ~.",
      "maxLength": 4096
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "read, connect (the udp reply), http (the unix socket body)"
    },
    "entries": {
      "type": "integer",
      "minimum": 0,
      "description": "read_dir"
    },
    "name": {
      "type": "string",
      "description": "env (the name only, never the value), dns",
      "maxLength": 4096
    },
    "host": {
      "type": "string",
      "description": "lookup, connect, tls",
      "maxLength": 4096
    },
    "answers": {
      "type": "integer",
      "minimum": 0,
      "description": "lookup"
    },
    "port": {
      "description": "connect",
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "addr": {
      "type": [
        "string",
        "null"
      ],
      "description": "connect: the IP address used.",
      "maxLength": 4096
    },
    "proto": {
      "type": "string",
      "description": "connect: udp for a datagram exchange. Absent for a TCP connection.",
      "enum": [
        "udp"
      ]
    },
    "via_proxy": {
      "type": [
        "string",
        "null"
      ],
      "description": "connect, kube: the proxy origin with the user info stripped, or null for a direct request",
      "maxLength": 4096
    },
    "sni": {
      "type": "string",
      "description": "tls",
      "maxLength": 4096
    },
    "header": {
      "type": "string",
      "description": "kube: name of the refused request header, never its value",
      "maxLength": 4096
    },
    "method": {
      "type": "string",
      "description": "http, kube",
      "maxLength": 4096
    },
    "url": {
      "type": "string",
      "description": "http, without query string",
      "maxLength": 4096
    },
    "status": {
      "description": "http, kube",
      "type": [
        "integer",
        "null"
      ]
    },
    "server": {
      "type": "string",
      "description": "dns: the nameserver's IP address.",
      "maxLength": 4096
    },
    "rtype": {
      "type": "string",
      "description": "dns",
      "maxLength": 4096
    },
    "api": {
      "type": "string",
      "description": "native, for example statvfs",
      "maxLength": 4096
    },
    "of": {
      "type": "string",
      "description": "coalesced: the kind that was coalesced",
      "maxLength": 4096
    },
    "under": {
      "type": "string",
      "description": "coalesced: the parent directory the file calls were under, or the program, host or path the other denied calls named, or * for denied calls past 100 targets",
      "maxLength": 4096
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "coalesced: how many calls the entry stands for. Reads past 200 per directory, or denied calls and failed file calls past 20 per parent directory (file calls) or target (other denied calls) and reason."
    },
    "truncated": {
      "description": "exec, read, connect (udp), http (unix socket)",
      "type": "boolean"
    }
  }
}
