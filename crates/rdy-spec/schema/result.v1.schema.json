{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getrdy.io/schema/rdy/v1/result.v1.schema.json",
  "title": "rdy/v1 run result",
  "description": "The JSON report rdy writes and Rdy Cloud reads. Ignore fields you do not know. Accept values not listed where a description says Open. Use verdict as written. A whole document is at most 2 MiB; readers should check that before parsing.",
  "$ref": "#/$defs/Report",
  "$defs": {
    "OpenCode": {
      "description": "A snake_case code. Newer producers may send values not listed.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Report": {
      "type": "object",
      "required": [
        "api_version",
        "kind",
        "producer",
        "run",
        "spec",
        "signature",
        "host",
        "identity",
        "capabilities",
        "verdict",
        "verdict_reason",
        "exit_code",
        "summary",
        "checks",
        "actions",
        "actions_truncated",
        "redaction",
        "complete",
        "interrupted",
        "actions_dropped"
      ],
      "properties": {
        "api_version": {
          "const": "rdy/v1"
        },
        "kind": {
          "const": "Report"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "run": {
          "$ref": "#/$defs/Run"
        },
        "spec": {
          "$ref": "#/$defs/SpecRef"
        },
        "signature": {
          "$ref": "#/$defs/Signature"
        },
        "host": {
          "$ref": "#/$defs/Host"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "proxy": {
          "$ref": "#/$defs/Proxy"
        },
        "capabilities": {
          "description": "Every need rdy probed before running checks, and the result.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "verdict": {
          "description": "Closed in v1. A new verdict value needs rdy/v2.",
          "enum": [
            "ready",
            "ready_with_warnings",
            "not_ready"
          ]
        },
        "verdict_reason": {
          "anyOf": [
            {
              "enum": [
                "required_check_not_run",
                "nothing_verified"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set when the verdict is not explained by an observed block or warn: required_check_not_run (not_ready with no block), nothing_verified (ready_with_warnings because no check reached pass, warn or block). Otherwise null. Open."
        },
        "exit_code": {
          "description": "Exit code for this verdict: 0, 1, 2. When rdy could not write the report it exits 70 instead and complete is false.",
          "enum": [
            0,
            1,
            2
          ]
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "checks": {
          "description": "One entry per spec check, in spec order. Sort by bucket for display.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckResult"
          }
        },
        "actions": {
          "description": "Every file read, command, lookup, connection and API request, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          },
          "maxItems": 5000
        },
        "actions_truncated": {
          "description": "True when the log hit 5000 entries. exec, connect, tls, http, dns, lookup and kube entries are never dropped.",
          "type": "boolean"
        },
        "actions_dropped": {
          "description": "How many entries of each kind were dropped when the log hit its cap. Only read, read_dir and stat entries are ever dropped.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "redaction": {
          "$ref": "#/$defs/Redaction"
        },
        "complete": {
          "description": "False when rdy could not finish or write the report (exit 70).",
          "type": "boolean"
        },
        "interrupted": {
          "description": "True when the run was cancelled (Ctrl-C). Unstarted and running checks are then skipped with skip_kind cancelled.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "ready_with_warnings"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "not_ready"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "signature": {
                "properties": {
                  "state": {
                    "const": "unsigned"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "run": {
                "properties": {
                  "options": {
                    "properties": {
                      "allow_unsigned": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "verdict_reason": {
                "type": "null"
              },
              "summary": {
                "properties": {
                  "block": {
                    "const": 0
                  },
                  "warn": {
                    "const": 0
                  },
                  "required_not_run": {
                    "const": 0
                  },
                  "optional_not_run": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "Producer": {
      "type": "object",
      "required": [
        "name",
        "version",
        "rdy_spec",
        "target"
      ],
      "properties": {
        "name": {
          "const": "rdy"
        },
        "version": {
          "type": "string",
          "description": "Version of the rdy binary.",
          "maxLength": 4096
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Short git commit of the build.",
          "maxLength": 4096
        },
        "rdy_spec": {
          "type": "string",
          "description": "Version of the rdy-spec crate that wrote this file.",
          "maxLength": 4096
        },
        "target": {
          "type": "string",
          "description": "Rust target triple.",
          "maxLength": 4096
        }
      }
    },
    "Run": {
      "type": "object",
      "required": [
        "id",
        "started_at",
        "finished_at",
        "duration_ms",
        "options"
      ],
      "properties": {
        "id": {
          "description": "Random UUID v4.",
          "type": "string",
          "format": "uuid"
        },
        "started_at": {
          "description": "UTC, with milliseconds.",
          "$ref": "#/$defs/Timestamp"
        },
        "finished_at": {
          "description": "UTC, with milliseconds.",
          "$ref": "#/$defs/Timestamp"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "options": {
          "type": "object",
          "required": [
            "jobs",
            "deadline_ms",
            "allow_unsigned",
            "network"
          ],
          "properties": {
            "jobs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "deadline_ms": {
              "type": "integer",
              "minimum": 1
            },
            "allow_unsigned": {
              "type": "boolean"
            },
            "network": {
              "description": "false when sockets were turned off for this run.",
              "type": "boolean"
            },
            "kube_context": {
              "type": [
                "string",
                "null"
              ],
              "description": "Context given with --kube-context, if any.",
              "maxLength": 4096
            }
          }
        }
      }
    },
    "SpecRef": {
      "type": "object",
      "required": [
        "product",
        "sha256",
        "file_name",
        "size_bytes"
      ],
      "properties": {
        "product": {
          "type": "string",
          "maxLength": 4096
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "sha256": {
          "description": "SHA-256 of the exact bytes that were verified and parsed.",
          "$ref": "#/$defs/Sha256"
        },
        "file_name": {
          "type": "string",
          "description": "Base name only, never the full path.",
          "maxLength": 4096
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "serial": {
          "type": [
            "integer",
            "null"
          ]
        },
        "expires": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "contact": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "Signature": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "anyOf": [
            {
              "enum": [
                "verified",
                "unsigned",
                "invalid"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            }
          ],
          "description": "verified: signed by a trusted key. unsigned: no signature, run with --allow-unsigned. invalid: only in the rdy verify object, never in a report. Open: treat an unknown value as not verified."
        },
        "key_id": {
          "description": "minisign key id, 16 uppercase hex digits.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9A-F]{16}$"
        },
        "key_fingerprint": {
          "description": "SHA-256 of the 32-byte ed25519 public key, 64 hex digits. The key id alone is not an identity.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "product": {
          "type": [
            "string",
            "null"
          ],
          "description": "Product from the signed trusted comment.",
          "maxLength": 4096
        },
        "signed_at": {
          "description": "From the signed trusted comment.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "trust_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "The local note from the trust store entry. Never text from the spec.",
          "maxLength": 4096
        },
        "trust_source": {
          "anyOf": [
            {
              "enum": [
                "system",
                "user",
                "flag"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the key came from: system or user trust store, or flag for a key given with --key for one run. Open: treat an unknown value like flag."
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "For invalid only.",
          "maxLength": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "verified"
              }
            }
          },
          "then": {
            "required": [
              "key_id",
              "key_fingerprint",
              "product",
              "signed_at",
              "trust_source"
            ],
            "properties": {
              "key_id": {
                "type": "string",
                "maxLength": 4096
              },
              "key_fingerprint": {
                "type": "string",
                "maxLength": 4096
              },
              "product": {
                "type": "string",
                "maxLength": 4096
              },
              "signed_at": {
                "type": "string",
                "maxLength": 4096
              },
              "trust_source": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        }
      ]
    },
    "Host": {
      "description": "The machine, coarsely. IP addresses appear only in check observed data and in the connect.addr and dns.server fields of actions. Never included: MAC addresses, environment values except proxy settings, the command line, the working directory, home paths, kubeconfig contents, the raw machine id, serial numbers.",
      "type": "object",
      "required": [
        "hostname",
        "host_id",
        "os",
        "arch"
      ],
      "properties": {
        "hostname": {
          "type": "string",
          "description": "As the OS reports it.",
          "maxLength": 4096
        },
        "host_id": {
          "description": "HMAC-SHA256 of the OS machine id with key 'rdy-host-id-v1' plus the product, first 16 hex digits. Same host and product give the same value; different products give unrelated values. null when there is no usable machine id (macOS for now).",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{16}$"
        },
        "os": {
          "type": "object",
          "required": [
            "family"
          ],
          "properties": {
            "family": {
              "anyOf": [
                {
                  "enum": [
                    "linux",
                    "macos",
                    "windows"
                  ]
                },
                {
                  "$ref": "#/$defs/OpenCode"
                }
              ]
            },
            "id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4096
            },
            "version": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4096
            },
            "pretty_name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4096
            }
          }
        },
        "kernel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "arch": {
          "type": "string",
          "maxLength": 4096
        },
        "virtualization": {
          "anyOf": [
            {
              "enum": [
                "none",
                "vm",
                "unknown"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            }
          ]
        },
        "container": {
          "description": "rdy ran inside a container or WSL.",
          "type": "boolean"
        }
      }
    },
    "Identity": {
      "description": "Who ran it.",
      "type": "object",
      "required": [
        "euid",
        "user",
        "elevated"
      ],
      "properties": {
        "euid": {
          "description": "Effective uid on Unix, null on Windows.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "user": {
          "type": [
            "string",
            "null"
          ],
          "description": "Local login name.",
          "maxLength": 4096
        },
        "elevated": {
          "description": "euid 0 on Unix, a high-integrity token on Windows.",
          "type": "boolean"
        },
        "kube": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "context": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4096
            },
            "server": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4096
            },
            "user": {
              "type": [
                "string",
                "null"
              ],
              "description": "The user entry named in the kubeconfig context. The authenticated user from SelfSubjectReview replaces it once that call is allowed.",
              "maxLength": 4096
            },
            "exec_plugin": {
              "description": "Base name of the kubeconfig credential plugin that ran, if any.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4096
            },
            "insecure_tls": {
              "description": "The context skips TLS verification.",
              "type": "boolean"
            }
          }
        }
      }
    },
    "Proxy": {
      "description": "Proxy settings in effect, user info stripped from URLs. null when none.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "https": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "http": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "no_proxy": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "Capability": {
      "type": "object",
      "required": [
        "need",
        "available"
      ],
      "properties": {
        "need": {
          "anyOf": [
            {
              "enum": [
                "root",
                "kube_context",
                "network",
                "command",
                "cloud_credentials"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            }
          ],
          "description": "Known: root, kube_context, network, command, cloud_credentials. Open."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Program name for command, provider for cloud_credentials.",
          "maxLength": 4096
        },
        "available": {
          "type": "boolean"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "description": "For example 'uid 1000' or 'context acme-staging'.",
          "maxLength": 4096
        },
        "hint": {
          "type": [
            "string",
            "null"
          ],
          "description": "What to do when not available.",
          "maxLength": 4096
        }
      },
      "description": "One thing rdy probed before running checks, such as root or a reachable cluster."
    },
    "Summary": {
      "type": "object",
      "required": [
        "total",
        "pass",
        "warn",
        "block",
        "skipped",
        "timeout",
        "error",
        "not_applicable",
        "required_not_run",
        "optional_not_run"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "block": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Every check with status skipped, not applicable included."
        },
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0,
          "description": "Skipped because the spec's os list leaves this OS out. Never counts toward the verdict."
        },
        "required_not_run": {
          "type": "integer",
          "minimum": 0,
          "description": "severity block and skipped (not not_applicable), timeout or error."
        },
        "optional_not_run": {
          "type": "integer",
          "minimum": 0,
          "description": "severity warn and skipped (not not_applicable), timeout or error."
        }
      },
      "description": "Counts. pass + warn + block + skipped + timeout + error = total. not_applicable, required_not_run and optional_not_run are views inside that sum. New keys may be added, so do not sum every key."
    },
    "CheckResult": {
      "type": "object",
      "required": [
        "key",
        "id",
        "name",
        "family",
        "severity",
        "status",
        "bucket",
        "message",
        "fix",
        "fix_source",
        "observed",
        "expected",
        "needs",
        "partial",
        "truncated",
        "notes",
        "started_ms",
        "duration_ms"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "id, or id/name when the spec gave a name. Unique in the report.",
          "maxLength": 4096
        },
        "id": {
          "type": "string",
          "maxLength": 4096
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "The spec's name for this entry, shown next to the id.",
          "maxLength": 4096
        },
        "family": {
          "type": "string",
          "maxLength": 4096
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "block",
                "warn"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            }
          ],
          "description": "From the spec. A value a consumer does not know counts as block. Open."
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "pass",
                "warn",
                "block",
                "skipped",
                "timeout",
                "error"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            }
          ],
          "description": "After severity is applied. An unknown status counts as not run. Open."
        },
        "bucket": {
          "description": "Display group, from the same rule as the verdict. Sort by it in this order: blocker, required_not_run, warning, passed, not_applicable. Do not recompute it. Open.",
          "anyOf": [
            {
              "enum": [
                "blocker",
                "required_not_run",
                "warning",
                "passed",
                "not_applicable"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            }
          ]
        },
        "skip_kind": {
          "anyOf": [
            {
              "enum": [
                "missing_need",
                "not_in_build",
                "unknown_check",
                "unsupported_spec",
                "not_yet_on_os",
                "not_applicable",
                "run_deadline",
                "cancelled"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            }
          ],
          "description": "Present when status is skipped. not_applicable comes only from the spec's os list; a check that cannot work on this OS is not_yet_on_os. Open."
        },
        "unsupported_fields": {
          "description": "For unsupported_spec: the fields this rdy could not read.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "timeout_after_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Present when status is timeout."
        },
        "error_kind": {
          "anyOf": [
            {
              "enum": [
                "check_failed",
                "panic"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            }
          ],
          "description": "Present when status is error. Open."
        },
        "message": {
          "type": "string",
          "description": "One line, at most 1 KiB, such as '15.4 GiB found, 32 GiB needed'.",
          "maxLength": 1024
        },
        "fix": {
          "type": [
            "string",
            "null"
          ],
          "description": "What to do. null only for pass and not applicable.",
          "maxLength": 4096
        },
        "fix_source": {
          "anyOf": [
            {
              "enum": [
                "spec",
                "rdy"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            },
            {
              "type": "null"
            }
          ],
          "description": "spec: the vendor's fix text. rdy: rdy's own text. null on pass. Open."
        },
        "builtin_fix": {
          "type": [
            "string",
            "null"
          ],
          "description": "rdy's text when the spec's fix replaced it.",
          "maxLength": 4096
        },
        "observed": {
          "description": "Measured values, at most 64 KiB. Keys per check id, snake_case, with the unit in the name (_bytes, _ms, _percent). Keys are only ever added.",
          "type": [
            "object",
            "null"
          ]
        },
        "expected": {
          "description": "Thresholds that applied after defaults. Same rules as observed.",
          "type": [
            "object",
            "null"
          ]
        },
        "needs": {
          "description": "Hard and soft needs the check declared, and whether each was met.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NeedState"
          }
        },
        "partial": {
          "description": "Set when some sources could not be read. A partial check never blocks on data it could not read.",
          "type": [
            "object",
            "null"
          ],
          "required": [
            "missing",
            "note"
          ],
          "properties": {
            "missing": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "enum": [
                      "root",
                      "kube_context",
                      "network",
                      "command",
                      "cloud_credentials"
                    ]
                  },
                  {
                    "$ref": "#/$defs/OpenCode"
                  }
                ],
                "description": "Known: root, kube_context, network, command, cloud_credentials. Open."
              }
            },
            "note": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        "truncated": {
          "description": "A size cap cut message, fix, observed or expected.",
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "started_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds after run.started_at."
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "skipped"
              }
            }
          },
          "then": {
            "required": [
              "skip_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "timeout"
              }
            }
          },
          "then": {
            "required": [
              "timeout_after_ms"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "error_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "warn",
                  "block",
                  "timeout",
                  "error"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "fix": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "skipped"
              },
              "skip_kind": {
                "not": {
                  "const": "not_applicable"
                }
              }
            },
            "required": [
              "skip_kind"
            ]
          },
          "then": {
            "properties": {
              "fix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "fix_source": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "NeedState": {
      "type": "object",
      "required": [
        "need",
        "hard",
        "met"
      ],
      "properties": {
        "need": {
          "anyOf": [
            {
              "enum": [
                "root",
                "kube_context",
                "network",
                "command",
                "cloud_credentials"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            }
          ],
          "description": "Known: root, kube_context, network, command, cloud_credentials. Open."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "hard": {
          "description": "true: the check does not run without it. false: it runs partial.",
          "type": "boolean"
        },
        "met": {
          "type": "boolean"
        }
      }
    },
    "Action": {
      "description": "One side effect, recorded as it happened. Fields beyond the required ones depend on kind.",
      "type": "object",
      "required": [
        "seq",
        "check",
        "at_ms",
        "duration_ms",
        "kind",
        "outcome"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "check": {
          "type": [
            "string",
            "null"
          ],
          "description": "Check key, or null for run-level probes.",
          "maxLength": 4096
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds after run.started_at."
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "exec",
                "read",
                "read_dir",
                "stat",
                "env",
                "lookup",
                "connect",
                "tls",
                "http",
                "dns",
                "kube",
                "native",
                "coalesced"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            }
          ],
          "description": "Open."
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "ok",
                "denied",
                "failed",
                "timeout"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            }
          ],
          "description": "denied: rdy's own policy refused it (see rule). failed: the OS or peer said no (see error). Open."
        },
        "rule": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "program": {
          "type": "string",
          "description": "exec",
          "maxLength": 4096
        },
        "argv": {
          "description": "exec, after redaction",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "exit": {
          "description": "exec",
          "type": [
            "integer",
            "null"
          ]
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "exec"
        },
        "path": {
          "type": "string",
          "description": "read, read_dir, stat, native, kube. Paths under a home directory start with ~.",
          "maxLength": 4096
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "read"
        },
        "entries": {
          "type": "integer",
          "minimum": 0,
          "description": "read_dir"
        },
        "name": {
          "type": "string",
          "description": "env (the name only, never the value), dns",
          "maxLength": 4096
        },
        "host": {
          "type": "string",
          "description": "lookup, connect, tls",
          "maxLength": 4096
        },
        "answers": {
          "type": "integer",
          "minimum": 0,
          "description": "lookup"
        },
        "port": {
          "description": "connect",
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "addr": {
          "type": [
            "string",
            "null"
          ],
          "description": "connect: the IP address used.",
          "maxLength": 4096
        },
        "via_proxy": {
          "type": [
            "string",
            "null"
          ],
          "description": "connect, user info stripped",
          "maxLength": 4096
        },
        "sni": {
          "type": "string",
          "description": "tls",
          "maxLength": 4096
        },
        "method": {
          "type": "string",
          "description": "http, kube",
          "maxLength": 4096
        },
        "url": {
          "type": "string",
          "description": "http, without query string",
          "maxLength": 4096
        },
        "status": {
          "description": "http, kube",
          "type": [
            "integer",
            "null"
          ]
        },
        "server": {
          "type": "string",
          "description": "dns: the nameserver's IP address.",
          "maxLength": 4096
        },
        "rtype": {
          "type": "string",
          "description": "dns",
          "maxLength": 4096
        },
        "api": {
          "type": "string",
          "description": "native, for example statvfs",
          "maxLength": 4096
        },
        "of": {
          "type": "string",
          "description": "coalesced: the kind that was coalesced",
          "maxLength": 4096
        },
        "under": {
          "type": "string",
          "description": "coalesced",
          "maxLength": 4096
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "coalesced"
        },
        "truncated": {
          "description": "exec, read",
          "type": "boolean"
        }
      }
    },
    "Verification": {
      "description": "Not a report. What rdy verify prints with --json when the spec is accepted.",
      "type": "object",
      "required": [
        "api_version",
        "kind",
        "producer",
        "spec",
        "signature"
      ],
      "properties": {
        "api_version": {
          "const": "rdy/v1"
        },
        "kind": {
          "const": "Verification"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "spec": {
          "$ref": "#/$defs/SpecRef"
        },
        "signature": {
          "$ref": "#/$defs/Signature"
        }
      }
    },
    "ErrorOutput": {
      "description": "Not a report. What rdy prints on stdout with --json when it exits 64 or 70 without a verdict. api_version and kind are written but not required.",
      "type": "object",
      "required": [
        "error",
        "verdict",
        "complete"
      ],
      "properties": {
        "api_version": {
          "const": "rdy/v1"
        },
        "kind": {
          "const": "Error"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "fix"
          ],
          "properties": {
            "code": {
              "description": "Stable code: usage, spec_parse, spec_invalid, spec_unsigned, spec_signature_invalid, spec_key_unknown, spec_expired, trust_store_insecure, report_write, internal. Open.",
              "$ref": "#/$defs/OpenCode"
            },
            "message": {
              "type": "string",
              "maxLength": 4096
            },
            "fix": {
              "type": "string",
              "maxLength": 4096
            },
            "file": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4096
            },
            "line": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "column": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "verdict": {
          "type": "null"
        },
        "complete": {
          "const": false
        }
      }
    },
    "Redaction": {
      "description": "What the redactor changed in this report. Counts only, never the matched text.",
      "type": "object",
      "required": [
        "ruleset",
        "total",
        "by_rule"
      ],
      "properties": {
        "ruleset": {
          "anyOf": [
            {
              "enum": [
                "report",
                "bundle"
              ]
            },
            {
              "$ref": "#/$defs/OpenCode"
            }
          ],
          "description": "Which compiled rule set ran. Open."
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "by_rule": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "LintReport": {
      "description": "Not a report. What rdy spec lint prints with --json.",
      "type": "object",
      "required": [
        "api_version",
        "kind",
        "file",
        "findings",
        "errors",
        "warnings"
      ],
      "properties": {
        "api_version": {
          "const": "rdy/v1"
        },
        "kind": {
          "const": "Lint"
        },
        "file": {
          "type": "string",
          "maxLength": 4096
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "code",
              "message",
              "fix"
            ],
            "properties": {
              "level": {
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "code": {
                "description": "Known: unknown_key, unknown_check, unsupported_field, bad_value, not_in_build, no_threshold, structure. Open.",
                "anyOf": [
                  {
                    "enum": [
                      "unknown_key",
                      "unknown_check",
                      "unsupported_field",
                      "bad_value",
                      "not_in_build",
                      "no_threshold",
                      "structure"
                    ]
                  },
                  {
                    "$ref": "#/$defs/OpenCode"
                  }
                ]
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "column": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "key": {
                "description": "Check key, or null for top-level findings.",
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4096
              },
              "message": {
                "type": "string",
                "maxLength": 4096
              },
              "fix": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
