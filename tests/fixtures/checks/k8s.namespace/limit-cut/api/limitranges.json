{
  "request": {
    "method": "GET",
    "path": "/api/v1/namespaces/acme-system/limitranges",
    "query": "limit=500"
  },
  "status": 200,
  "body": {
    "apiVersion": "v1",
    "kind": "LimitRangeList",
    "metadata": {
      "resourceVersion": "1000",
      "continue": "page-2"
    },
    "items": [
      {
        "apiVersion": "v1",
        "kind": "LimitRange",
        "metadata": {
          "name": "container-caps",
          "namespace": "acme-system"
        },
        "spec": {
          "limits": [
            {
              "type": "Container",
              "max": {
                "memory": "64Gi"
              }
            }
          ]
        }
      }
    ]
  }
}
