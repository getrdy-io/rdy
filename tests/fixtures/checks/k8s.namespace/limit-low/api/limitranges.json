{
  "request": {
    "method": "GET",
    "path": "/api/v1/namespaces/acme-system/limitranges",
    "query": "limit=500"
  },
  "status": 200,
  "body": {
    "apiVersion": "v1",
    "kind": "LimitRangeList",
    "metadata": {
      "resourceVersion": "1000"
    },
    "items": [
      {
        "apiVersion": "v1",
        "kind": "LimitRange",
        "metadata": {
          "name": "container-caps",
          "namespace": "acme-system"
        },
        "spec": {
          "limits": [
            {
              "type": "Container",
              "max": {
                "cpu": "4",
                "memory": "8Gi"
              },
              "default": {
                "cpu": "500m",
                "memory": "512Mi"
              },
              "defaultRequest": {
                "cpu": "100m",
                "memory": "256Mi"
              }
            },
            {
              "type": "PersistentVolumeClaim",
              "max": {
                "storage": "10Gi"
              }
            }
          ]
        }
      }
    ]
  }
}
