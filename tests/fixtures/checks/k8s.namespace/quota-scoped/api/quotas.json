{
  "request": {
    "method": "GET",
    "path": "/api/v1/namespaces/acme-system/resourcequotas",
    "query": "limit=500"
  },
  "status": 200,
  "body": {
    "apiVersion": "v1",
    "kind": "ResourceQuotaList",
    "metadata": {
      "resourceVersion": "1000"
    },
    "items": [
      {
        "apiVersion": "v1",
        "kind": "ResourceQuota",
        "metadata": {
          "name": "high-priority",
          "namespace": "acme-system"
        },
        "spec": {
          "hard": {
            "requests.cpu": "2"
          },
          "scopeSelector": {
            "matchExpressions": [
              {
                "scopeName": "PriorityClass",
                "operator": "In",
                "values": [
                  "acme-high"
                ]
              }
            ]
          }
        },
        "status": {
          "hard": {
            "requests.cpu": "2"
          },
          "used": {
            "requests.cpu": "1"
          }
        }
      },
      {
        "apiVersion": "v1",
        "kind": "ResourceQuota",
        "metadata": {
          "name": "long-running",
          "namespace": "acme-system"
        },
        "spec": {
          "hard": {
            "requests.memory": "4Gi"
          },
          "scopes": [
            "NotTerminating"
          ]
        },
        "status": {
          "hard": {
            "requests.memory": "4Gi"
          },
          "used": {
            "requests.memory": "1Gi"
          }
        }
      }
    ]
  }
}
