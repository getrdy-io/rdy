                    "/etc/coredns/Corefile"
                  ]
                },
                {
                  "name": "kube-rbac-proxy",
                  "image": "registry.acme.example/dns/kube-rbac-proxy:1.0",
                  "env": [
                    {
                      "name": "ACME_TOKEN",
                      "value": "ENV-VALUE-MUST-NOT-APPEAR"
                    }
                  ],
                  "args": [
                    "-conf",
                    "/etc/coredns/Corefile"
                  ]
