{
  "request": {
    "method": "GET",
    "path": "/apis/apps/v1/namespaces/kube-system/deployments",
    "query": "labelSelector=k8s-app=kube-dns&limit=500"
  },
  "status": 200,
  "body": {
    "apiVersion": "apps/v1",
    "kind": "DeploymentList",
    "metadata": {
      "resourceVersion": "1000"
    },
    "items": [
      {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "kube-dns",
          "namespace": "kube-system",
          "labels": {
            "k8s-app": "kube-dns"
          }
        },
        "spec": {
          "selector": {
            "matchLabels": {
              "k8s-app": "kube-dns"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "k8s-app": "kube-dns"
              }
            },
            "spec": {
              "containers": [
                {
                  "name": "kubedns",
                  "image": "registry.acme.example/dns/kubedns:1.0",
                  "env": [
                    {
                      "name": "ACME_TOKEN",
                      "value": "ENV-VALUE-MUST-NOT-APPEAR"
                    }
                  ],
                  "args": [
                    "-conf",
                    "/etc/coredns/Corefile"
                  ]
                },
                {
                  "name": "dnsmasq",
                  "image": "registry.acme.example/dns/dnsmasq:1.0",
                  "env": [
                    {
                      "name": "ACME_TOKEN",
                      "value": "ENV-VALUE-MUST-NOT-APPEAR"
                    }
                  ],
                  "args": [
                    "-conf",
                    "/etc/coredns/Corefile"
                  ]
                },
                {
                  "name": "sidecar",
                  "image": "registry.acme.example/dns/sidecar:1.0",
                  "env": [
                    {
                      "name": "ACME_TOKEN",
                      "value": "ENV-VALUE-MUST-NOT-APPEAR"
                    }
                  ],
                  "args": [
                    "-conf",
                    "/etc/coredns/Corefile"
                  ]
                },
                {
                  "name": "prometheus-to-sd",
                  "image": "registry.acme.example/dns/prometheus-to-sd:1.0",
                  "env": [
                    {
                      "name": "ACME_TOKEN",
                      "value": "ENV-VALUE-MUST-NOT-APPEAR"
                    }
                  ],
                  "args": [
                    "-conf",
                    "/etc/coredns/Corefile"
                  ]
                }
              ]
            }
          },
          "replicas": 2
        },
        "status": {
          "replicas": 2,
          "readyReplicas": 2
        }
      },
      {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "kube-dns-autoscaler",
          "namespace": "kube-system",
          "labels": {
            "k8s-app": "kube-dns-autoscaler"
          }
        },
        "spec": {
          "selector": {
            "matchLabels": {
              "k8s-app": "kube-dns-autoscaler"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "k8s-app": "kube-dns"
              }
            },
            "spec": {
              "containers": [
                {
                  "name": "autoscaler",
                  "image": "registry.acme.example/dns/autoscaler:1.0",
                  "env": [
                    {
                      "name": "ACME_TOKEN",
                      "value": "ENV-VALUE-MUST-NOT-APPEAR"
                    }
                  ],
                  "args": [
                    "-conf",
                    "/etc/coredns/Corefile"
                  ]
                }
              ]
            }
          },
          "replicas": 1
        },
        "status": {
          "replicas": 1,
          "readyReplicas": 1
        }
      }
    ]
  }
}
