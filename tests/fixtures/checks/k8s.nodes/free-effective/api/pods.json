{
  "request": {
    "method": "GET",
    "path": "/api/v1/pods",
    "query": "limit=500&fieldSelector=status.phase!=Succeeded,status.phase!=Failed"
  },
  "status": 200,
  "body": {
    "apiVersion": "v1",
    "kind": "PodList",
    "metadata": {
      "resourceVersion": "1000"
    },
    "items": [
      {
        "metadata": {
          "name": "web-1",
          "namespace": "app"
        },
        "spec": {
          "containers": [
            {
              "name": "main",
              "image": "registry.acme.example/acme/app:1",
              "resources": {
                "requests": {
                  "cpu": "1",
                  "memory": "200Mi"
                }
              }
            }
          ],
          "nodeName": "acme-node-1",
          "initContainers": [
            {
              "name": "proxy",
              "image": "registry.acme.example/acme/app:1",
              "resources": {
                "requests": {
                  "cpu": "1",
                  "memory": "100Mi"
                }
              },
              "restartPolicy": "Always"
            },
            {
              "name": "setup",
              "image": "registry.acme.example/acme/app:1",
              "resources": {
                "requests": {
                  "cpu": "2",
                  "memory": "500Mi"
                }
              }
            }
          ],
          "overhead": {
            "cpu": "250m",
            "memory": "50Mi"
          }
        },
        "status": {
          "phase": "Running"
        }
      },
      {
        "metadata": {
          "name": "done-1",
          "namespace": "app"
        },
        "spec": {
          "containers": [
            {
              "name": "main",
              "image": "registry.acme.example/acme/app:1",
              "resources": {
                "requests": {
                  "cpu": "3",
                  "memory": "1Gi"
                }
              }
            }
          ],
          "nodeName": "acme-node-1"
        },
        "status": {
          "phase": "Failed"
        }
      }
    ]
  }
}
