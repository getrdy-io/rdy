{
  "request": {
    "method": "GET",
    "path": "/apis/kyverno.io/v1/clusterpolicies",
    "query": "limit=500"
  },
  "status": 200,
  "body": {
    "apiVersion": "kyverno.io/v1",
    "kind": "ClusterPolicyList",
    "metadata": {
      "resourceVersion": "1000"
    },
    "items": [
      {
        "apiVersion": "kyverno.io/v1",
        "kind": "ClusterPolicy",
        "metadata": {
          "name": "require-owner"
        },
        "spec": {
          "validationFailureAction": "Enforce",
          "background": true,
          "rules": [
            {
              "name": "check-owner",
              "match": {
                "any": [
                  {
                    "resources": {
                      "kinds": [
                        "Pod"
                      ],
                      "namespaces": [
                        "acme-*"
                      ]
                    }
                  }
                ]
              },
              "validate": {
                "message": "needs a label",
                "pattern": {
                  "metadata": {
                    "labels": {
                      "owner": "?*"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      {
        "apiVersion": "kyverno.io/v1",
